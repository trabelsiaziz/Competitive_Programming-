vector<ll> sieve(int n) {
	int*arr = new int[n + 1](); vector<ll> vect;
	for (int i = 2; i <= n; i++)if (arr[i] == 0) {
		vect.push_back(i); 
		for (int j = 2 * i; j <= n; j += i)
			arr[j] = 1;
	}
	return vect;
}


ll pw(ll a, ll b){
	if(b == 0) return 1;
	ll res = 1;
	for(ll i = 0; i<b ; i++){
		res *= a;
	}
	return res ;
}

vector<pair<ll,ll>>fac(ll n){
	vector<pair<ll,ll>>res;
	if(n%2 == 0){
		int count = 0;
		while(n%2==0){
			count++;
			n/=2;
		}
		res.pb({2,count});
	}
	for(ll i = 3; i * i <= n; i+=2){
		if(n%i == 0){
			res.pb({i,0});
			while(n%i == 0){
				res.back().s++;
				n/=i;
			}
		}
	}
	if(n>1) res.pb({n,1});
	return res;
}

void dfs(int v){
	vis[v] = true;
	for(int u : adj[v]){
		if(!vis[u]){
			dfs(u);
		}
	}
}


int mex(vector<int> &a) {
    vector<bool> f(a.size() + 1, 0);
    for (int i : a) {
		if (i <= (int) a.size()) {
			f[i] = 1;
		}
	}
    int mex = 0;
    while (f[mex]) ++mex;
    return mex;
}




