const int mod = 1e9 + 7;
const int nax = 1e3;

vector<vector<bool>>vis(nax,vector<bool>(nax,false));
vector<vector<int>>in(nax,vector<int>(nax));

bool ind(pair<int ,int> p , pair<int ,int> pp, int n, int m){
	pair<int,int> ppp = {p.f+pp.f , p.s+pp.s};
	return ppp.s < n && ppp.f >= 0 && ppp.s < m && ppp.s >= 0;
	
}

vector<pair<int,int>> a = {{0,-1},{-1,0},{0,1},{1,0}};

ll dfs(int i, int k, int n, int m){
	vis[i][k] = true;
	ll res = in[i][k];
	for(auto h : a){
		if(ind({i,k} , h , n , m) && in[i+h.f][k+h.s] != 0 && !vis[i+h.f][k+h.s]){
			res += dfs(i+h.f , k+h.s ,n,m);
		}
	}
	return res;
}


void test_case(){
	int n,m;
	cin>>n>>m;
	for(int i = 0; i<n ; i++){
		for(int k = 0; k<m; k++){
			cin>>in[i][k];
			vis[i][k] = false;
		}
	}
	ll ans = 0;
	for(int i = 0; i<n ; i++){
		for(int k = 0; k<m ; k++){
			if(!vis[i][k] && in[i][k] != 0){
				ans = max(dfs(i,k,n,m),ans);
			}
		}
	}
	cout << ans << endl; 
		
}


